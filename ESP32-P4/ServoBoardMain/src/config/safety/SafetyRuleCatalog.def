// SafetyRuleCatalog.def - single source of truth for P4 safety rules.
// Fields: enum name, numeric ID, code, title, severity, layer, action, recovery.
// Included by the C++ enum and registry; do not add an include guard.
P4_SAFETY_RULE(ActuatorInvalidCommand, 1001, "ACT-1001", "Invalid servo command structure", Blocking, Actuator, RejectCommand, "Check batch size, Mxx indices, and command source.")
P4_SAFETY_RULE(ActuatorRouteUnknown, 1002, "ACT-1002", "Servo bus route is unknown", Blocking, Actuator, RejectCommand, "Wait for route scanning to finish or check servo power.")
P4_SAFETY_RULE(ActuatorRouteConflict, 1003, "ACT-1003", "Servo ID conflicts across buses", Blocking, Actuator, RejectCommand, "Remove the duplicate ID or assign it to only one bus.")
P4_SAFETY_RULE(ActuatorBusOverCapacity, 1004, "ACT-1004", "Servo bus capacity exceeded", Blocking, Actuator, RejectCommand, "Connect no more than 10 servos to each bus.")
P4_SAFETY_RULE(ActuatorEmergencyStop, 1005, "ACT-1005", "E-STOP is latched", Emergency, Actuator, DisableTorque, "Confirm mechanical safety, then press ENABLE again.")
P4_SAFETY_RULE(ActuatorInvalidOwner, 1006, "ACT-1006", "Command producer does not own output", Blocking, Actuator, RejectCommand, "Check mode switching and owner release.")
P4_SAFETY_RULE(ActuatorInvalidState, 1007, "ACT-1007", "System state rejects this servo command", Blocking, Actuator, RejectCommand, "Return to the matching DIRECT, FEEDBACK, or calibration state.")
P4_SAFETY_RULE(ActuatorOffline, 1008, "ACT-1008", "Target servo is offline", Blocking, Actuator, RejectCommand, "Check power, bus wiring, and servo ID.")
P4_SAFETY_RULE(ActuatorMultiTurnUnknown, 1009, "ACT-1009", "Servo multi-turn position is untrusted", Blocking, Actuator, RejectCommand, "Wait for JSON nearest-turn recovery; if it still fails, select the affected joint and recalibrate.")
P4_SAFETY_RULE(ActuatorStaleTarget, 1010, "ACT-1010", "Servo target is stale", Warning, Actuator, RejectCommand, "Check task blocking and the control producer period.")
P4_SAFETY_RULE(ActuatorLogicalRange, 1011, "ACT-1011", "Target exceeds the logical range", Blocking, Actuator, RejectCommand, "Check multi-turn recovery, logical offset, and upper-layer angle conversion.")
P4_SAFETY_RULE(ActuatorHardwareRange, 1012, "ACT-1012", "Target exceeds servo hardware travel", Emergency, Actuator, RejectCommand, "Check logicalOffset, multi-turn recovery, and target conversion.")
P4_SAFETY_RULE(ActuatorTurnOverflow, 1013, "ACT-1013", "Servo turn count reached the safety limit", Emergency, Actuator, DisableTorque, "Select the affected joint and recalibrate.")

P4_SAFETY_RULE(ControlCanFeedbackInvalid, 2001, "CTL-2001", "CAN or magnetic encoder feedback unavailable", Blocking, Control, HoldActualPosition, "Check S3, CAN wiring, and feedback freshness.")
P4_SAFETY_RULE(ControlJointIndexInvalid, 2002, "CTL-2002", "Invalid control joint index", Emergency, Control, HoldActualPosition, "Check HardwareMap and joint loop bounds.")
P4_SAFETY_RULE(ControlEncoderFault, 2003, "CTL-2003", "Target joint encoder fault", Blocking, Control, HoldActualPosition, "Check the affected encoder and S3 sensor state.")
P4_SAFETY_RULE(ControlMappedAngleInvalid, 2004, "CTL-2004", "Invalid mapped joint angle", Blocking, Control, HoldActualPosition, "Check Manual/Auto calibration and angle mapping.")
P4_SAFETY_RULE(ControlCollisionHold, 2005, "CTL-2005", "Insufficient joint motion triggered collision hold", Warning, Control, HoldActualPosition, "Confirm whether the hand contacted an object; a reverse target releases the hold.")
P4_SAFETY_RULE(ControlLutBoundaryClamp, 2006, "CTL-2006", "Dual-tendon PID output reached the LUT extension limit", Warning, Control, ClampToBoundary, "Check target angle, dual-tendon LUT calibration, and the 500-count runtime margin.")
P4_SAFETY_RULE(ControlJointTargetClamp, 2007, "CTL-2007", "Joint target exceeds the current dynamic range", Warning, Control, ClampToBoundary, "Check the requested target and current calibration range; recovery is automatic when the target returns in range.")
P4_SAFETY_RULE(ControlUpperWorkspaceWarning, 2008, "CTL-2008", "Joint feedback exceeded the Current Max warning boundary", Warning, Control, WarnOnly, "Check mechanical assembly, encoder direction, and Auto Max; recovery is automatic when feedback returns in range.")
P4_SAFETY_RULE(ControlHotplugHold, 2009, "CTL-2009", "Servo held at current ABS after hot-plug recovery", Warning, Control, HoldActualPosition, "Confirm trusted multi-turn state, then send an explicit target to release the hold.")

P4_SAFETY_RULE(SystemHostLeaseExpired, 3001, "SYS-3001", "Host control lease expired", Emergency, System, HoldActualPosition, "Check the desktop process, serial connection, and blocked tasks.")
P4_SAFETY_RULE(SystemStartStateRejected, 3002, "SYS-3002", "Current state rejected START", Warning, System, RejectCommand, "Resolve the active task or fault before retrying.")
P4_SAFETY_RULE(SystemDirectStateRejected, 3003, "SYS-3003", "Current state rejected direct control", Warning, System, RejectCommand, "Switch to a state that permits DIRECT control.")
P4_SAFETY_RULE(SystemFeedbackStateRejected, 3004, "SYS-3004", "Current state rejected feedback control", Warning, System, RejectCommand, "Complete Rope Init and wait for READY.")
P4_SAFETY_RULE(SystemCalibrationStateRejected, 3005, "SYS-3005", "Current state rejected automatic calibration", Warning, System, RejectCommand, "Stop other motion tasks before retrying.")

P4_SAFETY_RULE(DirectStateRejected, 3101, "DIR-3101", "Direct-control state admission failed", Warning, System, RejectCommand, "Stop the current task, then enable direct control again.")
P4_SAFETY_RULE(DirectHardwareRejected, 3102, "DIR-3102", "Selected direct-control servo is unavailable", Blocking, System, RejectCommand, "Check selected servo online state and bus routing.")
P4_SAFETY_RULE(DirectMultiTurnRejected, 3103, "DIR-3103", "Selected direct-control servo has unknown multi-turn state", Blocking, System, RejectCommand, "Wait for JSON nearest-turn recovery; recalibrate if recovery still fails.")
P4_SAFETY_RULE(DirectEventQueueRejected, 3104, "DIR-3104", "Direct-control state event queue is full", Warning, System, RejectCommand, "Check for a blocked state machine and retry later.")
P4_SAFETY_RULE(DirectStaleRejected, 3105, "DIR-3105", "Direct-control command generation is stale", Warning, System, RejectCommand, "Wait for mode switching to complete, then send the command again.")
P4_SAFETY_RULE(DirectFaultRejected, 3106, "DIR-3106", "System fault blocks direct control", Blocking, System, RejectCommand, "Resolve the status-bar fault, then press ENABLE again.")

P4_SAFETY_RULE(FeedbackManualMissing, 3201, "FBK-3201", "Feedback control is missing Manual references", Blocking, System, RejectCommand, "Enter Manual Min and Max for the selected joints in Device Check.")
P4_SAFETY_RULE(FeedbackStateRejected, 3202, "FBK-3202", "Feedback-control state admission failed", Warning, System, RejectCommand, "Wait for READY, then retry.")
P4_SAFETY_RULE(FeedbackWorkspaceRejected, 3203, "FBK-3203", "Joint is outside the dynamic workspace", Blocking, System, RejectCommand, "Run Rope Init to move the selected joints into READY.")
P4_SAFETY_RULE(FeedbackMultiTurnRejected, 3204, "FBK-3204", "Selected feedback-control servo has unknown multi-turn state", Blocking, System, RejectCommand, "Wait for JSON nearest-turn recovery; recalibrate if recovery still fails.")
P4_SAFETY_RULE(FeedbackAbsLimitRejected, 3205, "FBK-3205", "Feedback control is missing valid ABS or LUT limits", Blocking, System, RejectCommand, "Run automatic calibration again or load a matching snapshot.")
P4_SAFETY_RULE(FeedbackModeSwitchRejected, 3206, "FBK-3206", "Control mode switch is not complete", Warning, System, RejectCommand, "Wait for owner release, then send the target again.")
P4_SAFETY_RULE(FeedbackEventQueueRejected, 3207, "FBK-3207", "Feedback-control state event queue is full", Warning, System, RejectCommand, "Check for a blocked state machine and retry later.")

P4_SAFETY_RULE(ReadyCanGate, 3301, "RDY-3301", "CAN readiness gate failed", Blocking, System, MarkUncontrollable, "Check S3, CAN wiring, and magnetic encoder feedback.")
P4_SAFETY_RULE(ReadyMultiTurnGate, 3302, "RDY-3302", "READY multi-turn gate failed", Blocking, System, MarkUncontrollable, "Wait for JSON nearest-turn recovery or recalibrate.")
P4_SAFETY_RULE(ReadyEmptyScope, 3303, "RDY-3303", "READY active scope is empty", Warning, System, MarkIdle, "Select at least one joint in Joint Channels.")
P4_SAFETY_RULE(ReadyMappedUnavailable, 3304, "RDY-3304", "READY is missing a mapped-angle snapshot", Blocking, System, MarkIdle, "Check CAN feedback and mapped-angle publishing.")
P4_SAFETY_RULE(ReadyCalibrationMissing, 3305, "RDY-3305", "READY is missing Auto calibration", Blocking, System, MarkIdle, "Run automatic calibration for the selected joints.")
P4_SAFETY_RULE(ReadyMappedInvalid, 3306, "RDY-3306", "READY mapped angle is invalid", Blocking, System, MarkIdle, "Check Manual/Auto direction and span.")
P4_SAFETY_RULE(ReadyBelowWorkspace, 3307, "RDY-3307", "Joint is below the dynamic workspace", Warning, System, MarkIdle, "Run Rope Init.")
P4_SAFETY_RULE(ReadyCalibrationMismatch, 3308, "RDY-3308", "Manual and Auto calibration versions do not match", Blocking, System, MarkIdle, "Run automatic calibration again for the affected joint.")
P4_SAFETY_RULE(ReadyEncoderCanFault, 3309, "RDY-3309", "Active joint has an encoder or CAN fault", Blocking, System, MarkUncontrollable, "Check the affected encoder and CAN link.")
P4_SAFETY_RULE(ReadySystemFault, 3310, "RDY-3310", "System fault blocks READY", Blocking, System, MarkUncontrollable, "Resolve the fault bits, then evaluate READY again.")
P4_SAFETY_RULE(ReadyTurnOverflow, 3311, "RDY-3311", "Servo turn overflow blocks READY", Emergency, System, MarkUncontrollable, "Select the affected joint and recalibrate.")

P4_SAFETY_RULE(RopeInitTimeout, 3401, "ROP-3401", "Rope Init timed out", Blocking, Calibration, StopMotion, "Check tendon routing, winding direction, and workspace boundaries.")
P4_SAFETY_RULE(RopeInitFeedbackStale, 3402, "ROP-3402", "Rope Init feedback is stale", Blocking, Calibration, StopMotion, "Check servo and magnetic encoder feedback periods.")
P4_SAFETY_RULE(RopeInitServoOffline, 3403, "ROP-3403", "Servo went offline during Rope Init", Blocking, Calibration, StopMotion, "Check power and bus communication for the affected servo.")
P4_SAFETY_RULE(RopeInitMultiTurnUnknown, 3404, "ROP-3404", "Rope Init has unknown multi-turn state", Blocking, Calibration, StopMotion, "Wait for JSON nearest-turn recovery or recalibrate.")
P4_SAFETY_RULE(RopeInitManualRequired, 3405, "ROP-3405", "Rope Init is missing Manual data", Blocking, Calibration, StopMotion, "Enter Manual data in Device Check.")
P4_SAFETY_RULE(RopeInitAutoRequired, 3406, "ROP-3406", "Rope Init is missing Auto calibration", Blocking, Calibration, StopMotion, "Run automatic calibration for the affected joint first.")
P4_SAFETY_RULE(RopeInitTargetPublishFailed, 3407, "ROP-3407", "Rope Init target publish failed", Emergency, Calibration, StopMotion, "Check owner state, message channel, and the servo task.")
P4_SAFETY_RULE(RopeInitSystemFault, 3408, "ROP-3408", "System fault aborted Rope Init", Blocking, Calibration, StopMotion, "Resolve the system fault, then retry.")
P4_SAFETY_RULE(RopeInitCancelled, 3409, "ROP-3409", "Mode switching cancelled Rope Init", Info, Calibration, StopMotion, "Confirm the operation sequence, then start again.")

P4_SAFETY_RULE(FaultCanOffline, 3501, "FLT-3501", "CAN link offline fault", Blocking, System, MarkUncontrollable, "Restore S3 and CAN communication.")
P4_SAFETY_RULE(FaultOverload, 3502, "FLT-3502", "Servo overload fault", Emergency, Actuator, DisableTorque, "Remove mechanical binding or tendon blockage, then clear the fault.")
P4_SAFETY_RULE(FaultServoOffline, 3503, "FLT-3503", "Active servo offline fault", Blocking, System, MarkUncontrollable, "Restore power and routing for the affected servo.")
P4_SAFETY_RULE(FaultCalibration, 3504, "FLT-3504", "Automatic calibration failure", Blocking, Calibration, StopMotion, "Resolve the calibration diagnostic cause, then clear the fault.")
P4_SAFETY_RULE(FaultMultiTurnUnknown, 3505, "FLT-3505", "Unknown multi-turn position fault", Blocking, Recovery, MarkUncontrollable, "Wait for JSON nearest-turn recovery; recalibrate if recovery still fails.")

P4_SAFETY_RULE(CalibrationActiveScopeEmpty, 4001, "CAL-4001", "Calibration active scope is empty", Warning, Calibration, StopMotion, "Select at least one joint.")
P4_SAFETY_RULE(CalibrationEncoderError, 4005, "CAL-4005", "Encoder error during calibration", Blocking, Calibration, StopMotion, "Check the affected encoder and S3 error code.")
P4_SAFETY_RULE(CalibrationServoOffline, 4006, "CAL-4006", "Servo offline during calibration", Blocking, Calibration, StopMotion, "Check servo power, ID, and bus wiring.")
P4_SAFETY_RULE(CalibrationOverload, 4008, "CAL-4008", "Calibration load is too high", Emergency, Calibration, StopMotion, "Check for blocked tendon routing or mechanical interference.")
P4_SAFETY_RULE(CalibrationZeroCrossInvalid, 4013, "CAL-4013", "Invalid encoder wrap during calibration", Blocking, Calibration, StopMotion, "Check Manual direction and the wrap path.")
P4_SAFETY_RULE(CalibrationWrapTooLarge, 4014, "CAL-4014", "Calibration encoder wrap span is abnormal", Blocking, Calibration, StopMotion, "Check encoder readings and mechanical travel.")
P4_SAFETY_RULE(CalibrationAbsLimitInvalid, 4015, "CAL-4015", "Calibration ABS limit is invalid", Emergency, Calibration, StopMotion, "Check multi-turn coordinates and LUT endpoints.")
P4_SAFETY_RULE(CalibrationTargetPublishFailed, 4016, "CAL-4016", "Calibration target publish failed", Emergency, Calibration, StopMotion, "Check owner state, message channel, and the servo task.")
P4_SAFETY_RULE(CalibrationFeedbackLost, 4017, "CAL-4017", "Feedback lost during calibration", Blocking, Calibration, StopMotion, "Check servo and magnetic encoder feedback freshness.")
P4_SAFETY_RULE(CalibrationTaskStartFailed, 4018, "CAL-4018", "Automatic calibration task creation failed", Emergency, Calibration, StopMotion, "Check memory, stack, and task resources.")
P4_SAFETY_RULE(CalibrationControlLost, 4020, "CAL-4020", "Calibration lost output ownership", Blocking, Calibration, StopMotion, "Check mode switching and E-STOP operation order.")
P4_SAFETY_RULE(CalibrationHoldTargetFailed, 4021, "CAL-4021", "Failed to hold non-active joints", Emergency, Calibration, StopMotion, "Check active scope and servo feedback.")
P4_SAFETY_RULE(CalibrationJointListInvalid, 4022, "CAL-4022", "Calibration joint list is invalid", Warning, Calibration, StopMotion, "Check the active joint mask.")
P4_SAFETY_RULE(CalibrationDuplicateJoint, 4023, "CAL-4023", "Calibration joint list contains duplicates", Warning, Calibration, StopMotion, "Remove duplicate joint selections.")
P4_SAFETY_RULE(CalibrationWorkspacePrepFailed, 4024, "CAL-4024", "Dual-tendon workspace preparation failed", Blocking, Calibration, StopMotion, "Check helper dual-tendon motors, online state, and multi-turn state.")
P4_SAFETY_RULE(CalibrationJointStepFailed, 4025, "CAL-4025", "Joint calibration step failed", Blocking, Calibration, StopMotion, "Inspect phase and valueA/valueB/valueC diagnostics.")
P4_SAFETY_RULE(CalibrationServoRecoveryTimeout, 4026, "CAL-4026", "Timed out waiting for servo recovery during calibration", Blocking, Recovery, StopMotion, "Check hot-plug recovery and Turn Unknown state.")
P4_SAFETY_RULE(CalibrationReleaseOverTwoTurns, 4027, "CAL-4027", "Single tendon released more than two turns", Emergency, Calibration, StopMotion, "Check tendon routing and initial assembly before recalibrating.")
P4_SAFETY_RULE(CalibrationMotorMappingInvalid, 4028, "CAL-4028", "Calibration motor mapping is invalid", Blocking, Calibration, StopMotion, "Check J/M topology and dual-tendon primary/secondary mapping.")
P4_SAFETY_RULE(CalibrationResultSpanInvalid, 4029, "CAL-4029", "Calibration result travel is invalid", Blocking, Calibration, StopMotion, "Check encoder direction, mechanical endpoints, and effective travel.")
P4_SAFETY_RULE(CalibrationResultBuildFailed, 4030, "CAL-4030", "Calibration result build failed", Blocking, Calibration, StopMotion, "Check Manual references, endpoints, and LUT samples.")
P4_SAFETY_RULE(CalibrationResultCommitFailed, 4031, "CAL-4031", "Calibration result commit failed", Emergency, Calibration, StopMotion, "Check runtime calibration storage and the joint index.")
P4_SAFETY_RULE(CalibrationMultiTurnTrustFailed, 4032, "CAL-4032", "Calibration multi-turn trust commit failed", Blocking, Recovery, StopMotion, "Check servo online state, multi-turn configuration, and recovery state.")
P4_SAFETY_RULE(CalibrationDualExchangeStalled, 4034, "CAL-4034", "Joint stalled during dual-tendon exchange", Blocking, Calibration, StopMotion, "Check antagonistic tendon preload, exchange direction, encoder feedback, and mechanical binding.")
P4_SAFETY_RULE(CalibrationWarnAutoMinOffset, 4101, "CAW-4101", "Auto Min offset from Manual Min is insufficient", Warning, Calibration, WarnOnly, "Check release-side finger assembly clearance.")
P4_SAFETY_RULE(CalibrationWarnAutoMaxShortfall, 4102, "CAW-4102", "Auto Max offset from Manual Max is insufficient", Warning, Calibration, WarnOnly, "Check tightened-side finger assembly clearance.")
P4_SAFETY_RULE(CalibrationWarnSpanMismatch, 4103, "CAW-4103", "URDF and Manual span difference exceeds the limit", Warning, Calibration, WarnOnly, "Check Manual endpoints and mechanical assembly.")

P4_SAFETY_RULE(CommunicationCanInitFailed, 6001, "COM-6001", "CAN driver initialization failed", Emergency, Communication, MarkUncontrollable, "Check TWAI pins, power, and driver installation, then restart P4.")
P4_SAFETY_RULE(CommunicationCanFrameInvalid, 6002, "COM-6002", "CAN frame length or identifier is invalid", Warning, Communication, WarnOnly, "Check S3/P4 protocol versions and CAN bus interference.")
P4_SAFETY_RULE(CommunicationEncoderSnapshotInvalid, 6003, "COM-6003", "Encoder batch CRC or fragment is invalid", Blocking, Communication, HoldActualPosition, "Check CAN packet loss, CRC, and the S3 encoder publish period.")
P4_SAFETY_RULE(CommunicationTactileSnapshotInvalid, 6004, "COM-6004", "Tactile batch CRC or fragment is invalid", Warning, Communication, WarnOnly, "Check tactile fragment order, CRC, and CAN bandwidth.")
P4_SAFETY_RULE(CommunicationUpperFrameRejected, 6005, "COM-6005", "Desktop protocol frame was rejected", Warning, Communication, RejectCommand, "Check protocol version, command length, frame tail, and serial noise.")

P4_SAFETY_RULE(RuntimeSafetyEventCacheOverflow, 8001, "RUN-8001", "Safety event cache overflow", Warning, Runtime, WarnOnly, "Export recent safety events and check for a high-frequency repeated rule.")
P4_SAFETY_RULE(RuntimeQueueCreateFailed, 8002, "RUN-8002", "System queue creation failed", Emergency, Runtime, EnterFault, "Check heap memory and queue capacity, then restart P4.")
P4_SAFETY_RULE(RuntimeMutexCreateFailed, 8003, "RUN-8003", "System mutex creation failed", Emergency, Runtime, EnterFault, "Check heap memory and do not start business tasks.")
P4_SAFETY_RULE(RuntimeTaskCreateFailed, 8004, "RUN-8004", "Critical task creation failed", Emergency, Runtime, EnterFault, "Check task stack, priority, and available memory.")
P4_SAFETY_RULE(RuntimeTaskPeriodOverrun, 8005, "RUN-8005", "Real-time task repeatedly exceeded its period", Warning, Runtime, WarnOnly, "Check blocking calls, serial output, and task priority.")
P4_SAFETY_RULE(RuntimeTaskStackLow, 8006, "RUN-8006", "Real-time task stack is low", Emergency, Runtime, EnterFault, "Increase task stack or reduce large local objects, then validate again.")
