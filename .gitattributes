*.py text eol=lf
*.sh text eol=lf
.githooks/* text eol=lf
# CAD exports keep their exact original bytes (CRLF). Disabling text
# normalization keeps the recorded sha256 identical on every checkout;
# cr-at-eol keeps CR from being reported as trailing whitespace.
desktop/resources/mmhand_urdf/** -text whitespace=cr-at-eol
