{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "P4: Attach Arduino Debug Firmware",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\.debug\\p4\\ServoBoardMain.ino.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "D:\\esp32\\Espressif\\tools\\riscv32-esp-elf-gdb\\16.3_20250913\\riscv32-esp-elf-gdb\\bin\\riscv32-esp-elf-gdb.exe",
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "P4: Start OpenOCD",
      "customLaunchSetupCommands": [
        {
          "description": "Connect to the ESP32-P4 OpenOCD server",
          "text": "target-select remote localhost:3333",
          "ignoreFailures": false
        },
        {
          "description": "Reset and halt both P4 cores",
          "text": "monitor reset halt",
          "ignoreFailures": false
        },
        {
          "description": "Refresh registers after reset",
          "text": "flushregs",
          "ignoreFailures": true
        }
      ],
      "launchCompleteCommand": "exec-continue",
      "logging": {
        "engineLogging": false,
        "trace": false,
        "traceResponse": false
      }
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/Users/g8765/mmhand-debug/ESP32-P4/ServoBoardMain/src/system",
      "program": "c:/Users/g8765/mmhand-debug/ESP32-P4/ServoBoardMain/src/system/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}