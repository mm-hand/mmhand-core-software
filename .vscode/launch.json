{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "P4: Attach Arduino Debug Firmware",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\.debug\\p4\\ServoBoardMain.ino.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${env:LOCALAPPDATA}\\Arduino15\\packages\\esp32\\tools\\riscv32-esp-elf-gdb\\16.3_20250913\\bin\\riscv32-esp-elf-gdb.exe",
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "P4: Start OpenOCD",
      "customLaunchSetupCommands": [
        {
          "description": "Connect to the ESP32-P4 OpenOCD server",
          "text": "target-select remote localhost:3333",
          "ignoreFailures": false
        },
        {
          "description": "Reset and halt both P4 cores",
          "text": "monitor reset halt",
          "ignoreFailures": false
        },
        {
          "description": "Refresh registers after reset",
          "text": "flushregs",
          "ignoreFailures": true
        }
      ],
      "launchCompleteCommand": "exec-continue",
      "logging": {
        "engineLogging": false,
        "trace": false,
        "traceResponse": false
      }
    }
  ]
}
