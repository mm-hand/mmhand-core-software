# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Commit the project VS Code configuration, ignore other local files.
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# Generated project data
.debug/
run_data/
# Active calibration is runtime data created by the first calibration.
*.mmcal.json
!tests/fixtures/calibration_bundle.mmcal.json
# Atomic bundle writes leave this sibling behind if the process dies mid-save.
desktop/resources/config/.*.mmcal.json.*.tmp
# Live control parameters are local runtime state, seeded from .default.json.
desktop/resources/config/control_parameters.json

# Local firmware experiments and waveform captures
ESP32-P4/debug.log

# Local analysis/cache artifacts
.cache/
.ai-worktrees/
docs/ai/.explain_cache/
.understand-anything/
tmp/
desktop/resources/config/calib_load_snapshot.before_new_device_*.json
desktop/resources/mmhand_urdf_builtin/

*.egg-info/
desktop/resources/config/*.before-device-isolation.bak
reference/
.venv/
# Historical calibration and one-off local validation outputs
desktop/resources/config/*.before_*.json
desktop/resources/config/*.bak
simplify-*.log

# Tuning reports are local run artifacts
docs/debug/pid-autotuning-*.md
# Local debug plots/notes and temporary test runs
/docs/debug/assets/
/docs/debug/anti-slack-*.md
/.pytest-tmp-*/
/tools/debug/antislack_*.py
# Runtime diagnostics and recordings share the repository logs tree
/logs/
desktop/resources/config/backups/

# Arduino build directory used on Linux (.build/p4)
.build/
# arduino-cli 默认产物目录；本项目统一用 .build/p4，别把编译垃圾提交进来
ESP32-P4/build/
